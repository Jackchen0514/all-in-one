AIO_HOST=0.0.0.0
AIO_PORT=8080
AIO_DB=/opt/allinone/data/allinone.db
AIO_ADMIN_USER=admin
AIO_ADMIN_PASS=change-me
# 供外部系统调用的固定 API Token（留空则只能用登录 token）
AIO_API_TOKEN=
# 面板对外地址，用于生成订阅链接和节点回调地址
AIO_PUBLIC_URL=https://panel.example.com
# hysteria2 节点流量同步 / 踢人间隔（秒）；anytls / ss 节点由 allinone-agent 每 30 秒上报
AIO_SYNC_INTERVAL=60
# 每个用户的 Shadowsocks 端口从这个范围分配（避开 hysteria 端口跳跃常用的 20000-30000）
AIO_SS_PORT_RANGE=40000-49999
